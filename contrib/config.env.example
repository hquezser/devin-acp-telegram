# ~/.config/devin-acp-telegram/config.env — keep it private: chmod 600

# Token from @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=

# Telegram user ids allowed to drive Devin (ask @userinfobot), comma-separated.
TELEGRAM_ALLOWED_USERS=

# Project aliases: "/new app: fix the test" runs in ~/code/app.
#DEVIN_PROJECTS=app=~/code/app,api=~/code/api

# Mode of new sessions: accept-edits | smart | ask | plan | bypass
#DEVIN_MODE=accept-edits

# Let the Mac sleep while the bridge runs.
#DEVIN_CAFFEINE=0

# Messages in French.
#DEVIN_TG_LANG=fr
